# Environment Configuration Template
# Copy this file to .env and fill in your values

# Application
APP_NAME=MyApp
APP_ENV=development
APP_PORT=3000

# Database (uncomment if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=devuser
# DB_PASS=devpass
# DB_NAME=devdb

# API Keys (never commit real values)
# API_KEY=your_api_key_here
# SECRET_KEY=your_secret_here

# Debug
DEBUG=true
LOG_LEVEL=debug
