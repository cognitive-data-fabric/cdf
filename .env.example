# CDF Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit real secrets to version control

# ── Gateway ──────────────────────────────────────────────
CDF_HTTP_PORT=8080
CDF_GRPC_PORT=50053
CDF_ROUTER_ADDR=localhost:50050
CDF_STORAGE_NODES=localhost:50051,localhost:50052
REDIS_URL=localhost:6379
EMBED_URL=http://localhost:8001

# ── Storage Nodes ────────────────────────────────────────
CDF_NODE_ID=storage-1
CDF_DATA_DIR=./data
CDF_PORT=50051
CDF_SHARD_RANGE=0-32767

# ── Router ───────────────────────────────────────────────
CDF_ROUTER_PORT=50050

# ── Meta Service ────────────────────────────────────────
CDF_META_PORT=50054

# ── AI Services ─────────────────────────────────────────
MODEL_CACHE_DIR=./models
PORT=8001
DEVICE=cpu

# ── Drift Detector ──────────────────────────────────────
DRIFT_PORT=8002
EMBED_SERVICE_URL=http://localhost:8001

# ── MinIO (Object Storage) ──────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Authentication ───────────────────────────────────────
# API keys for gateway authentication
# CDF_API_KEYS=dev-key-abc123,dev-key-def456

# ── Logging ──────────────────────────────────────────────
RUST_LOG=info
LOG_LEVEL=info
